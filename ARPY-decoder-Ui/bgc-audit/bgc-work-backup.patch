+                        elif param == "CHLA_FLUORESCENCE":
+                            val = "CHLA_FLUORESCENCE_ADJUSTED = CHLA_FLUORESCENCE"
+                    elif cal_name == "SCIENTIFIC_CALIB_COEFFICIENT":
