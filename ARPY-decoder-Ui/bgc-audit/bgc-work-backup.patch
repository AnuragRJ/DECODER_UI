+    "total_profiles": "NUMBER_SubCyclesDoneSinceDeployment_COUNT",
+    "cycle": "NUMBER_InternalCycle_NUMBER",
+    "profile": "NUMBER_SubCycle_NUMBER",
+    "cycle_start_day": "CLOCK_StartInternalCycle_FloatDay",
