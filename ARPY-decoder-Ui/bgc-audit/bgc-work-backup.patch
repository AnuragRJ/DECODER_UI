+                    flu_vals=np.append(flu_vals, flu)
+                    beta_vals=np.append(beta_vals, beta)
+                    chla_vals=np.append(chla_vals, ch)
+                    bbp_vals=np.append(bbp_vals, bb)
+                    fl_pres=np.append(fl_pres, float(r.pres_dbar))
